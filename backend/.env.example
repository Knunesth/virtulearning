# ==============================================================================
# VIRTULEARNING BACKEND — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no git!
# ==============================================================================

# ── BANCO DE DADOS (TiDB Cloud) ───────────────────────────────────────────────
# Acesse: https://tidbcloud.com → seu cluster → Connect → "Connect with Prisma"
# O formato é: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://root:SUA_SENHA@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/virtulearning?ssl=true"

# ── JWT (Tokens de Autenticação) ──────────────────────────────────────────────
# Gere um secret forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="troque-por-uma-string-aleatoria-longa-aqui"
JWT_REFRESH_SECRET="troque-por-outra-string-aleatoria-longa-aqui"

# Tempo de expiração dos tokens
JWT_ACCESS_EXPIRES="15m"    # Access token: curto (15 minutos)
JWT_REFRESH_EXPIRES="7d"    # Refresh token: longo (7 dias)

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"      # "development" | "production"

# ── CORS (Origens permitidas) ─────────────────────────────────────────────────
# Em produção, coloque apenas o domínio do seu frontend
# Múltiplos domínios separados por vírgula
CORS_ORIGINS="http://localhost:5173,https://virtulearning.com.br"

# ── SEGURANÇA ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS="12"                # Custo do hash de senha (12 é o recomendado para produção)
MAX_LOGIN_ATTEMPTS="5"            # Tentativas antes de bloquear a conta
LOCKOUT_DURATION_MINUTES="15"     # Tempo de bloqueio em minutos
